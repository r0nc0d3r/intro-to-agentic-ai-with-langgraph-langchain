# Choose the LLM provider: ollama | anthropic | openai
LLM_PROVIDER=ollama

# --- Ollama (local, no API key needed) ---
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Path to the SQLite checkpoint DB (auto-created on first run)
CHECKPOINT_DB_PATH=.data/checkpoints.sqlite

# --- Langfuse observability (optional — leave blank to disable tracing) ---
# Default (no LANGFUSE_BASE_URL set) is Langfuse Cloud: https://cloud.langfuse.com
# For self-hosted Langfuse (see docker-compose.langfuse.yml in this repo),
# uncomment the line below and point it at your instance instead.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_HOST=http://localhost:3000  # deprecated alias for LANGFUSE_BASE_URL, kept for older SDK compat

# --- A2A cross-framework coordination (optional) ---
# Both default to "true" — if you don't have the Quiz Service / CrewAI Study
# Buddy A2A servers running (scripts/demo_chapter8.py starts both for a
# real end-to-end demo), the Progress Coach falls back gracefully, but you
# may see "Cannot connect" messages printed. Set to "false" to skip the
# discovery attempt entirely.
USE_A2A_QUIZ=true
USE_STUDY_BUDDY=true
QUIZ_SERVICE_URL=http://localhost:9001
STUDY_BUDDY_URL=http://localhost:9002
